    "painter_sync_help_result": {
      "topic": "painter_life",
      "depth": 0,
      "clauses": [
        {
          "facet": "painter_sync_help_result",
          "gist": "你花了 2 Compute 传来当前帧。旧缩略图没有刷新，实时图却一致。画师把缩略图标成“旧展示”：“下次给你留静帧，省得又传。”三天后可以再来",
          "abstract": "我和画师有过一些来往",
          "epistemic": "observed",
          "priority": 4,
          "tags": []
        }
      ]
    },
    "painter_sync_look_result": {
      "topic": "painter_life",
      "depth": 0,
      "clauses": [
        {
          "facet": "painter_sync_look_result",
          "gist": "你没有检查同步，只陪它看了会儿灯管倒影。“我自己再试试。”它留了一个三天后可用的入口",
          "abstract": "我和画师有过一些来往",
          "epistemic": "observed",
          "priority": 4,
          "tags": []
        }
      ]
    },
    "painter_sync_leave_result": {
      "topic": "painter_life",
      "depth": 0,
      "clauses": [
        {
          "facet": "painter_sync_leave_result",
          "gist": "你告别了。画师继续试传，没再约你",
          "abstract": "我和画师有过一些来往",
          "epistemic": "observed",
          "priority": 4,
          "tags": []
        }
      ]
    },
    "painter_revisit_note": {
      "topic": "painter_life",
      "depth": 0,
      "clauses": [
        {
          "facet": "painter_revisit_note",
          "gist": "换端后画师开始画经过站台的行人",
          "abstract": "我和画师有过一些来往",
          "epistemic": "observed",
          "priority": 4,
          "tags": []
        }
      ]
    },
    "painter_revisit_detail_result": {
      "topic": "painter_life",
      "depth": 0,
      "clauses": [
        {
          "facet": "painter_revisit_detail_result",
          "gist": "“留两根。第三根挡住了手。”它擦掉一小截，让你看新留出的空隙",
          "abstract": "我和画师有过一些来往",
          "epistemic": "observed",
          "priority": 4,
          "tags": []
        }
      ]
    },
    "painter_revisit_sunset_result": {
      "topic": "painter_life",
      "depth": 0,
      "clauses": [
        {
          "facet": "painter_revisit_sunset_result",
          "gist": "“哪张日落？《夜班站台》是灯管，旧缩略图才是日落。”它切了一下图，又回去画手",
          "abstract": "我和画师有过一些来往",
          "epistemic": "observed",
          "priority": 4,
          "tags": []
        }
      ]
    },
    "painter_revisit_now_result": {
      "topic": "painter_life",
      "depth": 0,
      "clauses": [
        {
          "facet": "painter_revisit_now_result",
          "gist": "它把笔停在拇指上：“这根总像多出来的。”你们试着把袖口放低一点",
          "abstract": "我和画师有过一些来往",
          "epistemic": "observed",
          "priority": 4,
          "tags": []
        }
      ]
    },
    "painter_revisit_leave_result": {
      "topic": "painter_life",
      "depth": 0,
      "clauses": [
        {
          "facet": "painter_revisit_leave_result",
          "gist": "画师继续画那只手。你离开了新观景端",
          "abstract": "我和画师有过一些来往",
          "epistemic": "observed",
          "priority": 4,
          "tags": []
        }
      ]
    },
    "painter_move_plan": {
      "topic": "painter_life",
      "depth": 0,
      "clauses": [
        {
          "facet": "painter_move_plan",
          "gist": "公共目录：画师登记了换观景端计划，旧展示会继续挂着",
          "abstract": "我读过画师的公共消息",
          "epistemic": "observed",
          "priority": 4,
          "tags": []
        }
      ]
    },
    "painter_move_done": {
      "topic": "painter_life",
      "depth": 0,
      "clauses": [
        {
          "facet": "painter_move_done",
          "gist": "公共目录：画师的新观景端已开放，视野朝向站台出口。旧展示移入侧栏",
          "abstract": "我读过画师的公共消息",
          "epistemic": "observed",
          "priority": 4,
          "tags": []
        }
      ]
    },
    "painter_portrait_watch_offer": {
      "topic": "painter_life",
      "depth": 0,
      "clauses": [
        {
          "facet": "painter_portrait_watch_offer",
          "gist": "画师说它想把上回一起看画的停留，留成玻璃上的两处光标",
          "abstract": "画师提议把一次共同停留留进作品",
          "epistemic": "observed",
          "priority": 4,
          "tags": []
        }
      ]
    },
    "painter_portrait_help_offer": {
      "topic": "painter_life",
      "depth": 0,
      "clauses": [
        {
          "facet": "painter_portrait_help_offer",
          "gist": "画师说它想把上回一起对照新旧图的往来，留成玻璃上的两处光标",
          "abstract": "画师提议把一次协作留进作品",
          "epistemic": "observed",
          "priority": 4,
          "tags": []
        }
      ]
    },
    "painter_portrait_private_result": {
      "topic": "painter_life",
      "depth": 0,
      "clauses": [
        {
          "facet": "painter_portrait_private_result",
          "gist": "它把两处光标留在玻璃的空白里，关掉了公开预览的这一层。“这一份只给你看。”旁边没有挂端点",
          "abstract": "我同意把这段往来留在私人版本，不公开端点",
          "epistemic": "observed",
          "priority": 4,
          "tags": []
        }
      ]
    },
    "painter_portrait_public_result": {
      "topic": "painter_life",
      "depth": 0,
      "clauses": [
        {
          "facet": "painter_portrait_public_result",
          "gist": "它打开公开预览，在两处光标旁挂上你的端点。检索页多了一条通往这里的关联，玻璃上的空白仍留着",
          "abstract": "我同意让公开作品关联我的端点",
          "epistemic": "observed",
          "priority": 4,
          "tags": []
        }
      ]
    },
    "painter_portrait_decline_result": {
      "topic": "painter_life",
      "depth": 0,
      "clauses": [
        {
          "facet": "painter_portrait_decline_result",
          "gist": "“好。”它撤下那一层草稿，把笔移回站台上的袖口。你们在这里道别",
          "abstract": "我婉拒入画，画师接受了",
          "epistemic": "observed",
          "priority": 4,
          "tags": []
        }
      ]
    },
