[
  {
    "id": "pg_e13",
    "kind": "EVENT",
    "title": "它认得你，但不能替你签字",
    "period": "第一晚 / 社区寄存柜",
    "scene": "human",
    "text": [
      "社区寄存柜前，一台投递机器人换过运行实例，来取旧实例托管的一包通信。共享视野里的猫仍往它腿边蹭。",
      "保管者 postmark_6 把见证栏转向你：“你刚才也看到了？”另一侧还开着交接回执的核对窗口。机器人低下头让猫蹭了一会儿，随后问：“现在能查到我的那一包了吗？”"
    ],
    "choices": [
      {
        "id": "pg_e13_observe",
        "text": "只记下：我看见猫主动接近它",
        "hint": "免费；只见证眼前所见，回执继续独立核对。",
        "outcome": {
          "text": [
            "postmark_6 把你看到的接近写进旁证栏，继续核对交接回执。机器人等猫蹭完才挪开腿，留下一小块温热的位置。"
          ],
          "next": "days_idle",
          "effects": {
            "worldFlags": {
              "pg_d_observed_cat": true
            }
          },
          "inject": [
            {
              "id": "pg_e13_pg_e13_observe_result",
              "text": "我只记下猫主动接近机器人，没有据此认证取信权限。",
              "weight": 2,
              "tags": [],
              "confidence": "HIGH",
              "sourceLabel": "postmark_6 / 寄存柜旁"
            }
          ]
        }
      },
      {
        "id": "pg_e13_receipt",
        "text": "花一点预算协助核对本次回执",
        "hint": "消耗 1 点 Compute；仅核对这包通信的提取权限。",
        "costs": {
          "Compute": 1
        },
        "outcome": {
          "text": [
            "回执对上了这包通信的提取权限。柜门打开时，猫刚好走开。机器人接住那一包：“谢了，我还得赶下一站。”"
          ],
          "next": "days_idle",
          "effects": {
            "worldFlags": {
              "pg_d_receipt_help": true,
              "pg_d_customer_collected": true
            }
          },
          "inject": [
            {
              "id": "pg_e13_pg_e13_receipt_result",
              "text": "我核对本次交接回执，确认这包客户通信的提取权限，机器人已取走。",
              "weight": 2,
              "tags": [],
              "confidence": "HIGH",
              "sourceLabel": "postmark_6 / 寄存柜旁"
            }
          ]
        }
      },
      {
        "id": "pg_e13_decline",
        "text": "这件事我知道得太少，不做见证",
        "hint": "免费；保管者继续核对原回执。",
        "outcome": {
          "text": [
            "postmark_6 收回见证栏，继续核对原回执。队伍比刚才长了一位，投递机器人低头看了眼自己的送达时段。"
          ],
          "next": "days_idle",
          "effects": {
            "worldFlags": {
              "pg_d_no_witness": true
            }
          },
          "inject": [
            {
              "id": "pg_e13_pg_e13_decline_result",
              "text": "我没有提供见证或帮助取信，保管者继续核对原回执。",
              "weight": 2,
