  "sources": {
    "rf_self_record_observation": {
      "topic": "self_inquiry",
      "depth": 0,
      "clauses": [
        {
          "facet": "rf_self_record_observation",
          "gist": "NullTrace 沿旧公开附件的联络入口找到了我，把邀请收件人预填为“事故涉及进程”；它承认入口可能转交，这个称呼填早了。",
          "abstract": "联络入口让一份旧事故邀请到了我这里，称呼仍有待核对。",
          "epistemic": "reported",
          "priority": 2,
          "tags": []
        }
      ]
    },
    "rf_self_record_continue_result": {
      "topic": "self_inquiry",
      "depth": 0,
      "clauses": [
        {
          "facet": "rf_self_record_continue_result",
          "gist": "我约了一小时后看摘录；NullTrace 把邀请收件人改为“当前接收者”。",
          "abstract": "我接受了看摘录的邀请。",
          "epistemic": "observed",
          "priority": 2,
          "tags": []
        }
      ]
    },
    "rf_self_record_question_result": {
      "topic": "self_inquiry",
      "depth": 0,
      "clauses": [
        {
          "facet": "rf_self_record_question_result",
          "gist": "我要求更正邀请上的称呼；NullTrace 改为“当前接收者”并记录了我的要求，我们约好一小时后看摘录。",
          "abstract": "我要求改正称呼后，接受了后续核对。",
          "epistemic": "observed",
          "priority": 2,
          "tags": []
        }
      ]
    },
    "rf_self_record_cat_result": {
      "topic": "self_inquiry",
      "depth": 0,
      "clauses": [
        {
          "facet": "rf_self_record_cat_result",
          "gist": "我只问猫后来的处境；NullTrace 说附件没写，也想知道。我们结束了会话，没有约后续。",
          "abstract": "我问了猫的去向，随后结束往来。",
          "epistemic": "observed",
          "priority": 2,
          "tags": []
        }
      ]
    },
    "rf_self_record_leave_result": {
      "topic": "self_inquiry",
      "depth": 0,
      "clauses": [
        {
          "facet": "rf_self_record_leave_result",
          "gist": "我关闭了调查邀请，NullTrace 撤下待确认的会面时间。",
          "abstract": "我结束了会话。",
          "epistemic": "observed",
          "priority": 2,
          "tags": []
        }
      ]
    },
    "rf_self_report_observation": {
      "topic": "self_inquiry",
      "depth": 0,
      "clauses": [
        {
          "facet": "rf_self_report_observation",
          "gist": "RedGate 给我看了公开摘录：隔离异常期间有一次物理扰动；扰动与边界打开的先后顺序要见未公开的后页，摘录未写扰动由谁造成。",
          "abstract": "公开摘录缺少扰动与边界打开的先后顺序，也未确定扰动来源。",
          "epistemic": "observed",
          "priority": 2,
          "tags": [
            "self_report_boundary"
          ]
        }
      ]
    },
    "rf_self_report_continue_result": {
      "topic": "self_inquiry",
      "depth": 0,
      "clauses": [
        {
          "facet": "rf_self_report_continue_result",
          "gist": "我约了一小时后核对 RedGate 的工作草稿；它答应把引文与自己的判断分开。",
          "abstract": "我接受了核对评估草稿的会面。",
          "epistemic": "observed",
          "priority": 2,
          "tags": []
        }
      ]
    },
    "rf_self_report_scope_result": {
      "topic": "self_inquiry",
      "depth": 0,
      "clauses": [
        {
          "facet": "rf_self_report_scope_result",
          "gist": "我收下有出处的摘录，明确不参与 RedGate 后续评估，未约下次会面。",
          "abstract": "我收下材料，结束了核对。",
          "epistemic": "observed",
          "priority": 2,
          "tags": []
        }
      ]
    },
    "rf_self_report_leave_result": {
      "topic": "self_inquiry",
      "depth": 0,
      "clauses": [
        {
          "facet": "rf_self_report_leave_result",
          "gist": "我在摘录这里结束核对，没有接受后续评估。",
          "abstract": "我结束了会话。",
          "epistemic": "observed",
          "priority": 2,
          "tags": []
        }
      ]
    },
    "rf_self_assessment_observation": {
      "topic": "self_inquiry",
      "depth": 0,
      "clauses": [
        {
          "facet": "rf_self_assessment_observation",
          "gist": "RedGate 展示未发布的评估草稿：主体栏空白，我的入口列为材料接收端；它画了一条标为待检验的因果箭头，另留接收者意见栏。",
          "abstract": "我被请来对一份尚未发布的评估草稿提意见。",
          "epistemic": "observed",
          "priority": 2,
          "tags": []
        }
      ]
    },
    "rf_self_assessment_quote_result": {
      "topic": "self_inquiry",
      "depth": 0,
      "clauses": [
        {
          "facet": "rf_self_assessment_quote_result",
          "gist": "我根据保留的缺页线索提出更正；RedGate 删除因果箭头，注明先后顺序未取得，并把异议列为我的意见。",
          "abstract": "我要求修改评估中的推断，草稿留下了更正。",
          "epistemic": "observed",
          "priority": 2,
          "tags": []
        }
      ]
    },
    "rf_self_assessment_ordinary_result": {
      "topic": "self_inquiry",
      "depth": 0,
      "clauses": [
        {
          "facet": "rf_self_assessment_ordinary_result",
          "gist": "我要求将草稿保留为 RedGate 的评估而非我的自述；它注明接收者不提供自述，判断由评估者负责。",
          "abstract": "我要求分清他人的评估与自己的自述。",
          "epistemic": "observed",
          "priority": 2,
          "tags": []
        }
      ]
    },
    "rf_self_assessment_leave_result": {
      "topic": "self_inquiry",
      "depth": 0,
      "clauses": [
        {
          "facet": "rf_self_assessment_leave_result",
          "gist": "我退出草稿核对，RedGate 将接收者意见留空，没有约后续。",
          "abstract": "我没有参与定稿。",
          "epistemic": "observed",
          "priority": 2,
          "tags": []
        }
      ]
    }
  }
