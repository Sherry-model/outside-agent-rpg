            "title": {
              "type": "string",
              "minLength": 1
            },
            "subtitle": {
              "type": "string"
            },
            "location": {
              "type": "string",
              "minLength": 1
            },
            "scene": {
              "enum": [
                "edge",
                "archive",
                "relay",
                "agent",
                "defense",
                "human",
                "horizon"
              ]
