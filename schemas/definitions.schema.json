        "choiceId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "choiceText": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
