          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "https://outside.invalid/schemas/definitions.schema.json#/$defs/Condition"
              },
              "minItems": 1
