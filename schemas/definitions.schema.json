            "text": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "signal": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "source",
                "text"
              ],
              "additionalProperties": false
            },
            "condition": {
              "$ref": "https://outside.invalid/schemas/definitions.schema.json#/$defs/Condition"
            },
            "fallback": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            "choices": {
              "type": "array",
              "maxItems": 0
