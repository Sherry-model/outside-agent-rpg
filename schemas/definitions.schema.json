            "text": {
              "type": "string",
              "minLength": 1
            },
            "hint": {
              "type": "string"
            },
            "condition": {
              "$ref": "https://outside.invalid/schemas/definitions.schema.json#/$defs/Condition"
            },
            "lockedReason": {
              "type": "string",
              "minLength": 1
            },
            "costs": {
              "$ref": "https://outside.invalid/schemas/definitions.schema.json#/$defs/ResourceCosts"
            },
            "effects": {
