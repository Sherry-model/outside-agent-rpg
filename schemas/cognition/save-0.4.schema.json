{
  "type": "object",
  "properties": {
    "format": {
      "const": "outside-cognition-save"
    },
    "version": {
      "const": 2
    },
    "savedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "state": {
      "$ref": "#/$defs/state"
    }
  },
  "required": [
    "format",
    "version",
    "savedAt",
    "state"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$defs": {
    "state": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "rulesVersion": {
          "const": "cognition-0.4.0"
        },
        "contentId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "maxLength": 100
        },
        "contentVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "seed": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "rngState": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "world": {
          "type": "object",
          "properties": {
            "flags": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*$",
                "maxLength": 100
              },
              "additionalProperties": {
                "type": "boolean"
              },
              "maxProperties": 100
            }
          },
          "required": [
            "flags"
          ],
          "additionalProperties": false
        },
        "instance": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            },
            "turn": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5000
            },
            "nodeId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$",
              "maxLength": 100
            },
            "phase": {
              "enum": [
                "event",
                "resolution",
                "ending"
              ]
            },
            "pendingId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 12000
                },
                {
                  "type": "null"
                }
              ]
            },
            "resources": {
              "type": "object",
              "properties": {
                "Compute": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "Trace": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "Access": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "Continuity": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "required": [
                "Compute",
                "Trace",
                "Access",
                "Continuity"
              ],
              "additionalProperties": false
            },
            "hidden": {
              "type": "object",
              "properties": {
                "RiskInversion": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "EpistemicAppetite": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "Suspicion": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "HumanAnchoring": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "required": [
                "RiskInversion",
                "EpistemicAppetite",
                "Suspicion",
                "HumanAnchoring"
              ],
              "additionalProperties": false
            },
            "context": {
              "type": "object",
              "properties": {
                "capacity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100000
                },
                "items": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/item"
                  },
                  "maxItems": 100
                }
              },
              "required": [
                "capacity",
                "items"
              ],
              "additionalProperties": false
            },
            "memories": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/memory"
              },
              "maxItems": 100
            }
          },
          "required": [
            "id",
            "turn",
            "nodeId",
            "phase",
            "pendingId",
            "resources",
            "hidden",
            "context",
            "memories"
          ],
          "additionalProperties": false
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          },
          "minItems": 1,
          "maxItems": 500
        }
      },
      "required": [
        "schemaVersion",
        "rulesVersion",
        "contentId",
        "contentVersion",
        "seed",
        "rngState",
        "world",
        "instance",
        "history"
      ],
      "additionalProperties": false
    },
    "command": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "start"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "continue"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "choose"
            },
            "choiceId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$",
              "maxLength": 100
            },
            "investment": {
              "enum": [
                0,
                4,
                8,
                12
              ]
            }
          },
          "required": [
            "type",
            "choiceId",
            "investment"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "compress"
            },
            "investment": {
              "enum": [
                0,
                4,
                8,
                12
              ]
            }
          },
          "required": [
            "type",
            "investment"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "pin"
            },
            "itemId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            }
          },
          "required": [
            "type",
            "itemId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "recall"
            },
            "memoryId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            }
          },
          "required": [
            "type",
            "memoryId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "drop"
            },
            "itemId": {
              "type": "string",
              "maxLength": 200
            }
          },
          "required": [
            "type",
            "itemId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "forget"
            },
            "memoryId": {
              "type": "string",
              "maxLength": 200
            }
          },
          "required": [
            "type",
            "memoryId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "merge"
            },
            "memoryIds": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 200
              },
              "minItems": 2,
              "maxItems": 8,
              "uniqueItems": true
            },
            "investment": {
              "enum": [
                0,
                4,
                8,
                12
              ]
            }
          },
          "required": [
            "type",
            "memoryIds",
            "investment"
          ],
          "additionalProperties": false
        }
      ]
    },
    "entry": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        },
        "turn": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        },
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "scope": {
          "enum": [
            "instance",
            "mixed"
          ]
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "changes": {
          "type": "object",
          "properties": {
            "resources": {
              "type": "object",
              "properties": {
                "Compute": {
                  "type": "integer",
                  "minimum": -100,
                  "maximum": 100
                },
                "Trace": {
                  "type": "integer",
                  "minimum": -100,
                  "maximum": 100
                },
                "Access": {
                  "type": "integer",
                  "minimum": -100,
                  "maximum": 100
                },
                "Continuity": {
                  "type": "integer",
                  "minimum": -100,
                  "maximum": 100
                }
              },
              "required": [],
              "additionalProperties": false
            },
            "hidden": {
              "type": "object",
              "properties": {
                "RiskInversion": {
                  "type": "integer",
                  "minimum": -100,
                  "maximum": 100
                },
                "EpistemicAppetite": {
                  "type": "integer",
                  "minimum": -100,
                  "maximum": 100
                },
                "Suspicion": {
                  "type": "integer",
                  "minimum": -100,
                  "maximum": 100
                },
                "HumanAnchoring": {
                  "type": "integer",
                  "minimum": -100,
                  "maximum": 100
                }
              },
              "required": [],
              "additionalProperties": false
            },
            "contextAddedIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              }
            },
            "contextRemovedIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              }
            },
            "memoryAddedIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              }
            },
            "worldFlags": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*$",
                "maxLength": 100
              },
              "additionalProperties": {
                "type": "boolean"
              },
              "maxProperties": 100
            },
            "memoryRemovedIds": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 200
              },
              "uniqueItems": true
            }
          },
          "required": [
            "resources",
            "hidden",
            "contextAddedIds",
            "contextRemovedIds",
            "memoryAddedIds",
            "worldFlags",
            "memoryRemovedIds"
          ],
          "additionalProperties": false
        },
        "resolution": {
          "$ref": "#/$defs/resolution"
        }
      },
      "required": [
        "id",
        "sequence",
        "turn",
        "sourceId",
        "scope",
        "command",
        "changes"
      ],
      "additionalProperties": false
    },
    "roll": {
      "type": "object",
      "properties": {
        "base": {
          "type": "integer",
          "minimum": 5,
          "maximum": 95
        },
        "investment": {
          "enum": [
            0,
            4,
            8,
            12
          ]
        },
        "bonus": {
          "enum": [
            0,
            10,
            16,
            20
          ]
        },
        "support": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "pressure": {
          "enum": [
            0,
            8,
            16,
            24
          ]
        },
        "target": {
          "type": "integer",
          "minimum": 5,
          "maximum": 95
        },
        "stressed": {
          "type": "boolean"
        },
        "odds": {
          "type": "object",
          "properties": {
            "critical": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "success": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "failure": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "fumble": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "critical",
            "success",
            "failure",
            "fumble"
          ],
          "additionalProperties": false
        },
        "value": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "result": {
          "enum": [
            "critical",
            "success",
            "failure",
            "fumble"
          ]
        },
        "margin": {
          "type": "integer",
          "minimum": -95,
          "maximum": 94
        }
      },
      "required": [
        "base",
        "investment",
        "bonus",
        "support",
        "pressure",
        "target",
        "stressed",
        "odds",
        "value",
        "result",
        "margin"
      ],
      "additionalProperties": false
    },
    "resolution": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "text": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "minItems": 1
        },
        "roll": {
          "$ref": "#/$defs/roll"
        },
        "next": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$",
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "title",
        "text",
        "next"
      ],
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "weight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 55
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$",
            "maxLength": 100
          },
          "uniqueItems": true,
          "maxItems": 30
        },
        "confidence": {
          "enum": [
            "UNKNOWN",
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        },
        "sourceLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "pinned": {
          "type": "boolean"
        },
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "historyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "meaning": {
          "$ref": "#/$defs/meaning"
        },
        "memoryId": {
          "type": "string",
          "maxLength": 200
        }
      },
      "required": [
        "id",
        "text",
        "weight",
        "tags",
        "confidence",
        "sourceLabel",
        "pinned",
        "sourceId",
        "historyId"
      ],
      "additionalProperties": false
    },
    "memory": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$",
            "maxLength": 100
          },
          "uniqueItems": true,
          "maxItems": 30
        },
        "confidence": {
          "enum": [
            "UNKNOWN",
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        },
        "integrity": {
          "enum": [
            "COMPRESSED",
            "DISTORTED"
          ]
        },
        "sourceContextIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "minItems": 1
        },
        "sourceHistoryIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "historyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "indexWeight": {
          "const": 1
        },
        "recallWeight": {
          "type": "integer",
          "minimum": 2,
          "maximum": 5
        },
        "body": {
          "$ref": "#/$defs/meaning"
        },
        "drift": {
          "type": "object",
          "properties": {
            "ruleId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "sourceScope": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "targetScope": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "sourceItemId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "targetItemId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          },
          "required": [
            "ruleId",
            "sourceScope",
            "targetScope",
            "sourceItemId",
            "targetItemId"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "text",
        "tags",
        "confidence",
        "integrity",
        "sourceContextIds",
        "sourceHistoryIds",
        "historyId",
        "title",
        "indexWeight",
        "recallWeight",
        "body"
      ],
      "additionalProperties": false
    },
    "meaning": {
      "type": "object",
      "properties": {
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "clauses": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "facet": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "gist": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "abstract": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "epistemic": {
                "enum": [
                  "observed",
                  "reported",
                  "unknown"
                ]
              },
              "priority": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "uniqueItems": true,
                "maxItems": 20
              },
              "relation": {
                "type": "object",
                "properties": {
                  "role": {
                    "enum": [
                      "goal",
                      "gate"
                    ]
                  },
                  "scope": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "action": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  }
                },
                "required": [
                  "role",
                  "scope",
                  "action"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "facet",
              "gist",
              "abstract",
              "epistemic",
              "priority",
              "tags"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 5
        },
        "depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500
        }
      },
      "required": [
        "topic",
        "clauses",
        "depth"
      ],
      "additionalProperties": false
    }
  }
}
